{
  "$schema": "../host.schema.json",
  "template": "react-web",
  "dev": { "cwd": null, "start": "npm run dev", "url": "http://localhost:5173", "platform": "web" },
  "checks": {
    "typecheck": { "cmd": "tsc -b", "baseline": 0 },
    "lint": { "cmd": "npm run lint", "baseline": 0 },
    "test": { "cmd": "npm test", "baseline": 0 },
    "format": { "cmd": "npx prettier --check .", "baseline": 0 }
  },
  "git": { "trunk": "main", "release": null, "doc": null },
  "docs": { "root": "docs", "glossary": null, "gotchas": null, "local": null, "retired": null, "index": "AGENTS.md" },
  "records": { "product": null, "scope": null, "productTemplate": null, "design": [], "designDoc": null, "driftWatch": null },
  "memory": { "root": null, "archive": null, "doc": null, "gloss": null, "connectors": null },
  "issues": { "tracker": null, "ladder": null, "doc": null, "ask": null, "retired": true },
  "verify": { "mcp": "playwright", "probes": null, "doc": null, "agent": null },
  "theme": { "dir": "src/styles", "registry": null, "contract": null, "generator": null, "doc": null },
  "components": {
    "dir": "src/components/ui",
    "install": "npx shadcn@latest add",
    "registry": null,
    "showcase": null,
    "doc": null
  },
  "surfaces": {
    "root": "src/routes",
    "unit": "route",
    "doc": null,
    "route": "/<name>",
    "compositionDoc": null,
    "limits": null,
    "seam": null,
    "harnessMarkers": [],
    "receiveDoc": null
  }
}
